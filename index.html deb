                genre: "Komediya",
                rating: "9.4",
                episodesCount: 12,
                poster: "https://s4.anilist.co/file/anilistcdn/media/anime/cover/large/bx151801-0g6b6k4h1s3L.jpg",
                desc: "Sehr-jodu hamma narsani hal qiladigan dunyoda umuman sehri yo'q Mash Burnedead faqat tinimsiz mashq qilingan mushaklari bilan barchani mag'lub etadi.",
                recentUpdates: [
                    { ep: 12, time: "3 kun oldin" }
                ]
            }
        ];

        let savedIds = JSON.parse(localStorage.getItem("saved_animes") || "[]");
        let currentGenre = "Barchasi";

        // BOTGA O'TISH FUNKSIYASI (SHFFOF TUGMA BOSILGANDA)
        function openInBot(botCode, ep = 1, event) {
            if (event) event.stopPropagation();
            const param = `anime_${botCode}_ep_${ep}`;
            const url = `https://t.me/${BOT_USERNAME}?start=${param}`;
            if (tg && tg.openTelegramLink) {
                tg.openTelegramLink(url);
            } else {
                window.open(url, "_blank");
            }
        }

        // SAQLASH (BOOKMARK)
        function toggleSave(id, event) {
            if (event) event.stopPropagation();
            if (savedIds.includes(id)) {
                savedIds = savedIds.filter(item => item !== id);
            } else {
                savedIds.push(id);
            }
            localStorage.setItem("saved_animes", JSON.stringify(savedIds));
            renderAll();
        }

        // KARTOCHKA SHABLONI
        function createCardHTML(anime, isGrid = false) {
            const isSaved = savedIds.includes(anime.id);
            return `
                <div class="${isGrid ? '' : 'h-card'}" onclick="openModal('${anime.id}')">
                    <div class="poster-wrap">
                        <img src="${anime.poster}" alt="${anime.title}" loading="lazy">
                        <span class="badge-type">${anime.genre}</span>
                        <button class="bookmark-btn ${isSaved ? 'saved' : ''}" onclick="toggleSave('${anime.id}', event)">
                            <i class="fa-${isSaved ? 'solid' : 'regular'} fa-bookmark"></i>
                        </button>
                        <button class="glass-watch-btn" onclick="openInBot('${anime.botCode}', 1, event)">
                            <i class="fa-solid fa-play"></i> Ko'rish
                        </button>
                    </div>
                    <div class="card-title">${anime.title}</div>
                    <div class="card-meta">
                        <span class="star">★ ${anime.rating}</span> • ${anime.episodesCount} qism
                    </div>
                </div>
            `;
        }

        // BARCHA BO'LIMLARNI CHIZISH
        function renderAll(searchQuery = "") {
            const filtered = ANIME_DATA.filter(a => {
                const matchSearch = a.title.toLowerCase().includes(searchQuery.toLowerCase());
                const matchGenre = currentGenre === "Barchasi" || a.genre === currentGenre;
                return matchSearch && matchGenre;
            });

            // Mashhur animelar
            document.getElementById("popularContainer").innerHTML = ANIME_DATA.map(a => createCardHTML(a, false)).join("");

            // So'nggi yangilanishlar
            document.getElementById("updatesContainer").innerHTML = ANIME_DATA.map(a => `
                <div class="update-card" onclick="openModal('${a.id}')">
                    <img src="${a.poster}" alt="${a.title}">
                    <div class="update-info">
                        <div class="update-title">${a.title}</div>
                        <div>
                            ${a.recentUpdates.map(u => `
                                <div class="ep-row" onclick="openInBot('${a.botCode}', ${u.ep}, event)">
                                    <span class="ep-name">${u.ep}-qism</span>
                                    <span class="ep-time">${u.time}</span>
                                </div>
                            `).join("")}
                        </div>
                    </div>
                </div>
            `).join("");

            // Katalog
            document.getElementById("catalogCount").innerText = filtered.length;
            document.getElementById("catalogGrid").innerHTML = filtered.map(a => createCardHTML(a, true)).join("");

            // Saqlanganlar
            const savedList = ANIME_DATA.filter(a => savedIds.includes(a.id));
            document.getElementById("savedCountStat").innerText = savedList.length;
            document.getElementById("emptySaved").style.display = savedList.length ? "none" : "block";
            document.getElementById("savedGrid").innerHTML = savedList.map(a => createCardHTML(a, true)).join("");
        }

        function handleSearch(val) {
            if (val.trim().length > 0) switchTab('catalog');
            renderAll(val);
        }

        function filterGenre(genre, btn) {
            currentGenre = genre;
            document.querySelectorAll(".chip").forEach(c => c.classList.remove("active"));
            btn.classList.add("active");
            renderAll(document.getElementById("globalSearch").value);
        }

        function switchTab(tabName, btn) {
            document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
            document.getElementById(`page-${tabName}`).classList.add("active");
            if (btn) {
                document.querySelectorAll(".nav-item").forEach(n => n.classList.remove("active"));
                btn.classList.add("active");
            }
        }

        // MODAL OYNANI OCHISH
        function openModal(id) {
            const anime = ANIME_DATA.find(a => a.id === id);
            if (!anime) return;

            document.getElementById("modalImg").src = anime.poster;
            document.getElementById("modalTitle").innerText = anime.title;
            document.getElementById("modalTags").innerHTML = `
                <span style="color:var(--accent-yellow); font-weight:700;">★ ${anime.rating}</span>
                <span>• ${anime.genre}</span>
                <span>• ${anime.episodesCount} qism</span>
            `;
            document.getElementById("modalDesc").innerText = anime.desc;
            document.getElementById("modalMainWatchBtn").onclick = () => openInBot(anime.botCode, 1);

            let epsHTML = "";
            for (let i = 1; i <= anime.episodesCount; i++) {
                epsHTML += `<button class="ep-btn" onclick="openInBot('${anime.botCode}', ${i})">${i}-qism</button>`;
            }
            document.getElementById("modalEpisodes").innerHTML = epsHTML;
            document.getElementById("animeModal").classList.add("open");
        }

        function closeModal() {
            document.getElementById("animeModal").classList.remove("open");
        }

        function showRandomAnime() {
            const rnd = ANIME_DATA[Math.floor(Math.random() * ANIME_DATA.length)];
            openModal(rnd.id);
        }

        renderAll();
    </script>
</body>
</html>
